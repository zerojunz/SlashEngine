{
  "entities": {
    "age": {
      "components": {
        "Control": {},
        "LineEdit": {
          "max_length": 3,
          "placeholder_text": "Age",
          "virtual_keyboard_type": "number"
        }
      }
    },
    "form": {
      "components": {
        "BoxContainer": {
          "vertical": true
        },
        "Control": {
          "children": ["title", "name", "password", "age", "status"],
          "custom_minimum_size": [240.0, 0.0],
          "offset_left": 40.0,
          "offset_top": 16.0
        }
      }
    },
    "name": {
      "components": {
        "Control": {},
        "LineEdit": {
          "clear_button_enabled": true,
          "max_length": 20,
          "placeholder_text": "Your name"
        }
      }
    },
    "password": {
      "components": {
        "Control": {},
        "LineEdit": {
          "placeholder_text": "Password",
          "secret": true,
          "virtual_keyboard_type": "password"
        }
      }
    },
    "status": {
      "components": {
        "Control": {},
        "Label": {}
      }
    },
    "title": {
      "components": {
        "Control": {},
        "Label": {
          "text": "Sign up"
        }
      }
    }
  },
  "format": 1
}
