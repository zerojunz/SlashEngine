# A street lamp, written by hand as an exporter would: meters, y up, faces counter-clockwise
# seen from outside.
mtllib lamp.mtl

# The base has its own normals.
o Base
usemtl Iron
v -0.2 0 -0.2
v -0.2 0 0.2
v -0.2 0.2 -0.2
v -0.2 0.2 0.2
v 0.2 0 -0.2
v 0.2 0 0.2
v 0.2 0.2 -0.2
v 0.2 0.2 0.2
vn 1 0 0
f 5//1 7//1 8//1 6//1
vn -1 0 0
f 1//2 2//2 4//2 3//2
vn 0 1 0
f 3//3 4//3 8//3 7//3
vn 0 -1 0
f 1//4 5//4 6//4 2//4
vn 0 0 1
f 2//5 6//5 8//5 4//5
vn 0 0 -1
f 1//6 3//6 7//6 5//6

# The pole has none: its sides are smooth, its top flat.
o Pole
usemtl Iron
v 0.06 0.2 0
v 0.0424 0.2 0.0424
v 0 0.2 0.06
v -0.0424 0.2 0.0424
v -0.06 0.2 0
v -0.0424 0.2 -0.0424
v 0 0.2 -0.06
v 0.0424 0.2 -0.0424
v 0.06 2.4 0
v 0.0424 2.4 0.0424
v 0 2.4 0.06
v -0.0424 2.4 0.0424
v -0.06 2.4 0
v -0.0424 2.4 -0.0424
v 0 2.4 -0.06
v 0.0424 2.4 -0.0424
f 17 18 10 9
f 18 19 11 10
f 19 20 12 11
f 20 21 13 12
f 21 22 14 13
f 22 23 15 14
f 23 24 16 15
f 16 9 17 24
s off
f 24 23 22 21 20 19 18 17

# The lantern: glass, and an iron roof on it.
o Lantern
usemtl Glass
v -0.15 2.4 -0.15
v -0.15 2.4 0.15
v -0.15 2.75 -0.15
v -0.15 2.75 0.15
v 0.15 2.4 -0.15
v 0.15 2.4 0.15
v 0.15 2.75 -0.15
v 0.15 2.75 0.15
f 29 31 32 30
f 25 26 28 27
f 27 28 32 31
f 25 29 30 26
f 26 30 32 28
f 25 27 31 29
usemtl Iron
s off
v 0 2.98 0
v -0.21 2.75 -0.21
v 0.21 2.75 -0.21
v 0.21 2.75 0.21
v -0.21 2.75 0.21
f 35 34 33
f 36 35 33
f 37 36 33
f 34 37 33
f 34 35 36 37
