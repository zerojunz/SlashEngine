{
  "format": 1,
  "height": 64,
  "nodes": {
    "ao": {"op": "image", "path": "props/crate.maps/ao.png"},
    "curvature": {"op": "image", "path": "props/crate.maps/curvature.png"},
    "dirty": {"base": "wood", "layer": "ao", "mode": "multiply", "op": "blend"},
    "edges": {"in": [0.55, 0.8], "input": "curvature", "op": "levels"},
    "grain": {
      "noise": {"frequency": 0.08, "noise_type": "cellular", "seed": 3},
      "op": "noise",
      "seamless": true
    },
    "worn": {"base": "dirty", "layer": "edges", "mode": "screen", "op": "blend", "opacity": 0.6},
    "wood": {
      "gradient": {
        "points": [
          {"color": [0.36, 0.24, 0.13, 1.0], "offset": 0.0},
          {"color": [0.66, 0.48, 0.29, 1.0], "offset": 1.0}
        ]
      },
      "input": "grain",
      "op": "gradient_map"
    }
  },
  "outputs": [{"name": "albedo", "node": "worn"}],
  "type": "graph",
  "width": 64
}
