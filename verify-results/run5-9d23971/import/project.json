    "IA_Look/right": {
      "events": [
        {
          "axis": "right_x",
          "axis_value": 1,
          "type": "joypad_motion"
        }
      ]
    },
    "IA_Look/up": {
      "events": [
        {
          "axis": "right_y",
          "axis_value": -1,
          "type": "joypad_motion"
        }
      ]
    },
    "IA_Move/down": {
      "events": [
        {
          "key": "S",
          "type": "key"
        },
        {
          "key": "Down",
          "type": "key"
