#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

// Ray-traced reflections on a GPU that traces rays (RenderDevice::ray_tracing), after Forward+'s
// prepass: the hardware twin of run_ray_reflections in src/ray_shadows.cpp, which the software
// device runs and which holds the steps' reasons. Each pixel the prepass drew smoother than
// kRayReflectionCutoff is put back in the world from its depth, moved off its surface along its
// normal, and sends size.z rays reflected about GGX's visible normals for its roughness through
// the frame's acceleration structure. What a ray meets first is shaded as path_reflection in
// src/path_trace.cpp shades it: its surface from its draw's material, vertices and textures
// (surface_pixel in src/mesh.cpp), what it gives off, what the frame's lights send it through
// their shadows (light_reach and light_compute), and the environment's light along its normal and
// mirror direction. The light the rays bring back, divided by the rays sent, and the share that
// met something go in reflection_image, which the screen texture's layer 1 takes as SSR's.
//
// GLSL rather than HLSL, as glslang's HLSL has no ray queries; cmake/compile_ray_shaders.cmake
// compiles it into ray_light_shaders.hpp.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// One instance a draw, its custom index the draw's place in draws: mask 1 for the draws rays
// from the camera's side see, 2 for those that cast shadows.
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1) uniform sampler2D depth_texture;   // the prepass's depth, reversed
layout(set = 0, binding = 2) uniform sampler2D normal_texture;  // its view-space normals, 0 to 1,
                                                                // and roughness * 127 / 255
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D reflection_image;

// RayLightFrame in src/vulkan_rays.cpp.
layout(set = 0, binding = 4, std140) uniform Frame {
    mat4 to_world;     // the prepass's clip space to the world
    vec4 view_rows[3]; // the world to the camera's space, a row each
    uvec4 size;        // width, height, rays a pixel, lights
    vec4 ambient;      // the ambient light, then 1 when the environment is the sky's radiance
    vec4 sky_rows[3];  // the world to the sky's space, a row each; w: the sky's scale, its share
};

// A draw as rays meet it: RayDrawRecord in src/vulkan_rays.cpp.
struct Draw {
    vec4 albedo;
    vec4 emission;          // rgb, then its energy
    vec4 surface;           // metallic, roughness, specular, normal scale
    vec4 metallic_channel;
    vec4 roughness_channel;
    uvec4 options;          // mesh.hlsl's flags, the scissor threshold's bits, layers
    vec4 normal_rows[3];    // its normals' matrix, a row each
    vec4 uv1;               // scale, then offset
    uvec4 buffers;          // its vertices' and triangles' device addresses, low word first
    uvec4 textures;         // the albedo, metallic, roughness and emission textures in textures
    uvec4 more;             // the normal texture, then its cull mode (0 back, 1 front, 2 none)
};
layout(set = 0, binding = 5, std430) readonly buffer Draws {
    Draw draws[];
};

// A light: RayLightRecord in src/vulkan_rays.cpp, mesh.hlsl's Light then its shadow.
struct Light {
    vec4 position;  // xyz, then 1 over its range
    vec4 direction; // xyz, then its kind: 0 directional, 1 omni, 2 spot
    vec4 color;     // linear, times its energy; then its specular amount
    vec4 params;    // its attenuation, a spot's cone cosine and attenuation
    uvec4 masks;    // the layers it lights, its shadow caster mask, 1 when it casts shadows
    vec4 shadow;    // its shadow opacity
};
layout(set = 0, binding = 6, std430) readonly buffer Lights {
    Light lights[];
};

// The sky's radiance, sRGB, as the mesh pass samples it; any cube when the environment is the
// ambient light.
layout(set = 0, binding = 7) uniform samplerCube environment_map;
// The draws' textures; kNoTexture reads white.
layout(set = 0, binding = 8) uniform sampler2D textures[64];

// A mesh's vertices (Vertex3D, 15 words each) and triangles, by device address.
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words {
    uint words[];
};

const uint kVertexWords = 15u;
const uint kNoTexture = 0xFFFFFFFFu;
const uint kSeeMask = 1u;
const uint kCastMask = 2u;

const float kOffsetShare = 0.003;
const float kOffsetLeast = 0.002;
const float kR2X = 0.7548776662;
const float kR2Y = 0.5698402910;
const float kPi = 3.14159265358979;
const uint kReflectionSeed = 0xB0u;
const float kReflectionCutoff = 0.7;
const float kMinBounceRoughness = 0.03;
const float kFar = 3.402823466e38;

// mesh.hlsl's Surface flags (kMesh* in src/mesh_shading.hpp).
const uint kUnshaded = 1u;
const uint kVertexColorAlbedo = 2u;
const uint kAlphaScissor = 4u;
const uint kEmissionTexture = 8u;
const uint kNormalMap = 16u;
const uint kSideCheck = 32u;
const uint kHasAlpha = 64u;

uint mix_bits(uint x) {
    x ^= x >> 16u;
    x *= 0x7FEB352Du;
    x ^= x >> 15u;
    x *= 0x846CA68Bu;
    x ^= x >> 16u;
    return x;
}

float unit_of(uint bits) {
    return float(bits >> 8u) * (1.0 / 16777216.0);
}

void basis(vec3 n, out vec3 t, out vec3 b) {
    float sign_z = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (sign_z + n.z);
    float c = n.x * n.y * a;
    t = vec3(1.0 + (sign_z * n.x * n.x * a), sign_z * c, -sign_z * n.x);
    b = vec3(c, sign_z + (n.y * n.y * a), -n.y);
}

// GGX's microfacet normals as v sees them, about n: sample_visible_normal in src/path_trace.cpp.
vec3 sample_visible_normal(vec3 n, vec3 v, float alpha, float u1, float u2) {
    vec3 t;
    vec3 b;
    basis(n, t, b);
    vec3 vl = vec3(dot(v, t), dot(v, b), dot(v, n));
    vec3 vh = normalize(vec3(alpha * vl.x, alpha * vl.y, vl.z));
    float lensq = (vh.x * vh.x) + (vh.y * vh.y);
    vec3 t1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) / sqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 t2 = cross(vh, t1);
    float r = sqrt(u1);
    float turn = 2.0 * kPi * u2;
    float p1 = r * cos(turn);
    float p2 = r * sin(turn);
    float s = 0.5 * (1.0 + vh.z);
    p2 = ((1.0 - s) * sqrt(max(0.0, 1.0 - (p1 * p1)))) + (s * p2);
    vec3 nh = (t1 * p1) + (t2 * p2) + (vh * sqrt(max(0.0, 1.0 - (p1 * p1) - (p2 * p2))));
    vec3 local = normalize(vec3(alpha * nh.x, alpha * nh.y, max(0.0, nh.z)));
    return normalize((t * local.x) + (b * local.y) + (n * local.z));
}

vec3 srgb_to_linear(vec3 color) {
    return color * (color * (color * 0.305306011 + 0.682171111) + 0.012522878);
}

// x to the power y for x of 0 or more.
float power(float x, float y) {
    return x > 0.0 ? exp(y * log(x)) : 0.0;
}

// A vertex's words.
uint word(uvec2 address, uint at) {
    return Words(address).words[at];
}
vec3 vector_at(uvec2 address, uint at) {
    return vec3(uintBitsToFloat(word(address, at)), uintBitsToFloat(word(address, at + 1u)),
                uintBitsToFloat(word(address, at + 2u)));
}

// A triangle's corners' first words in its draw's vertices.
uvec3 corners_of(Draw draw, uint primitive) {
    uvec2 indices = draw.buffers.zw;
    uint at = primitive * 3u;
    return uvec3(word(indices, at), word(indices, at + 1u), word(indices, at + 2u)) * kVertexWords;
}

// The corners' values at a point of a triangle, as the rasterizer gives them to a pixel: mesh_vertex
// in src/mesh.cpp, then blended.
struct Pixel {
    vec3 world;
    vec3 face;     // the triangle's counterclockwise normal in the world
    vec3 normal;
    vec3 tangent;
    vec3 binormal;
    vec2 uv;
    vec4 color;
};
Pixel pixel_at(Draw draw, uint primitive, vec2 shares, mat4x3 to_world) {
    uvec2 vertices = draw.buffers.xy;
    uvec3 corners = corners_of(draw, primitive);
    vec3 weights = vec3(1.0 - shares.x - shares.y, shares.x, shares.y);
    mat3 normal_model = transpose(mat3(draw.normal_rows[0].xyz, draw.normal_rows[1].xyz,
                                       draw.normal_rows[2].xyz));
    Pixel pixel;
    pixel.world = vec3(0.0);
    pixel.normal = vec3(0.0);
    pixel.tangent = vec3(0.0);
    pixel.binormal = vec3(0.0);
    pixel.uv = vec2(0.0);
    pixel.color = vec4(0.0);
    vec3 places[3];
    for (uint i = 0u; i < 3u; ++i) {
        uint at = corners[i];
        vec3 position = vector_at(vertices, at);
        vec3 normal = vector_at(vertices, at + 3u);
        vec3 tangent = vector_at(vertices, at + 6u);
        float handed = uintBitsToFloat(word(vertices, at + 9u));
        vec2 uv = vec2(uintBitsToFloat(word(vertices, at + 10u)),
                       uintBitsToFloat(word(vertices, at + 11u)));
        vec4 color = unpackUnorm4x8(word(vertices, at + 12u));
        vec3 binormal = normalize(cross(normal, tangent) * handed);
        places[i] = to_world * vec4(position, 1.0);
        float w = weights[i];
        pixel.world += places[i] * w;
        pixel.normal += normalize(normal_model * normal) * w;
        pixel.tangent += normalize(normal_model * tangent) * w;
        pixel.binormal += normalize(normal_model * binormal) * w;
        pixel.uv += ((uv * draw.uv1.xy) + draw.uv1.zw) * w;
        pixel.color += color * w;
    }
    pixel.face = cross(places[1] - places[0], places[2] - places[0]);
    return pixel;
}

vec4 texel(uint index, vec2 uv) {
    if (index == kNoTexture) {
        return vec4(1.0);
    }
    return textureLod(textures[nonuniformEXT(index)], uv, 0.0);
}

// A draw's albedo and alpha at a pixel, as surface_pixel takes them, before the scissor.
vec4 albedo_at(Draw draw, Pixel pixel) {
    vec4 color = draw.albedo * texel(draw.textures.x, pixel.uv);
    if ((draw.options.x & kVertexColorAlbedo) != 0u) {
        color *= pixel.color;
    }
    return color;
}

// Whether a ray from the camera's side meets a candidate: from the side its draw's cull mode
// shows, and where its alpha keeps it (the scissor, or a blended alpha above a number hashed from
// the ray and the triangle).
bool keeps(rayQueryEXT query, vec3 direction, uint seed) {
    uint index = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, false));
    uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, false));
    Draw draw = draws[index];
    uint cull = draw.more.y;
    uint flags = draw.options.x;
    bool tested = (flags & (kAlphaScissor | kHasAlpha)) != 0u;
    if (cull == 2u && !tested) {
        return true;
    }
    Pixel pixel = pixel_at(draw, primitive, rayQueryGetIntersectionBarycentricsEXT(query, false),
                           rayQueryGetIntersectionObjectToWorldEXT(query, false));
    // Front faces wind clockwise as the ray sees them.
    bool front = dot(direction, pixel.face) > 0.0;
    if ((cull == 0u && !front) || (cull == 1u && front)) {
        return false;
    }
    if (!tested) {
        return true;
    }
    float alpha = albedo_at(draw, pixel).a;
    if ((flags & kAlphaScissor) != 0u) {
        return alpha >= uintBitsToFloat(draw.options.y);
    }
    return alpha >= 1.0 || unit_of(mix_bits(seed ^ mix_bits(index ^ mix_bits(primitive)))) < alpha;
}

// Whether something casting the light's shadows stops a ray within distance.
bool blocked(vec3 origin, vec3 direction, float distance, uint caster_mask) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsTerminateOnFirstHitEXT, kCastMask, origin, 0.0,
                          direction, distance);
    while (rayQueryProceedEXT(query)) {
        uint index = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, false));
        if ((draws[index].options.z & caster_mask) != 0u) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    return rayQueryGetIntersectionTypeEXT(query, true) !=
           gl_RayQueryCommittedIntersectionNoneEXT;
}

// A point to start a ray from at a surface, off it to the side the ray leaves by: offset in
// src/path_trace.cpp.
vec3 offset(vec3 point, vec3 face, vec3 direction) {
    float size = max(1.0, max(abs(point.x), max(abs(point.y), abs(point.z))));
    float amount = 1e-4 * size;
    return point + (face * (dot(face, direction) >= 0.0 ? amount : -amount));
}

// The environment's light along a direction: the sky's radiance over the ambient light by its
// share, or the ambient light.
vec3 environment(vec3 direction) {
    if (ambient.w == 0.0) {
        return ambient.rgb;
    }
    vec3 turned = vec3(dot(sky_rows[0].xyz, direction), dot(sky_rows[1].xyz, direction),
                       dot(sky_rows[2].xyz, direction));
    vec3 sky = srgb_to_linear(textureLod(environment_map, turned, 0.0).rgb) * sky_rows[0].w;
    return mix(ambient.rgb, sky, sky_rows[1].w);
}

float schlick_fresnel(float u) {
    float m = 1.0 - u;
    float m2 = m * m;
    return m2 * m2 * m;
}

// light_compute in mesh.hlsl: the light a light sends toward v, diffuse times the albedo's
// share and specular.
vec3 light_compute(vec3 n, vec3 l, vec3 v, vec3 light_color, float attenuation, vec3 f0,
                   float roughness, float metallic, float specular_amount, vec3 base) {
    float n_dot_l = min(dot(n, l), 1.0);
    float c_n_dot_l = max(n_dot_l, 0.0);
    float c_n_dot_v = max(dot(n, v), 1e-4);
    vec3 h = normalize(v + l);
    float c_n_dot_h = clamp(dot(n, h), 0.0, 1.0);
    float c_l_dot_h = clamp(dot(l, h), 0.0, 1.0);
    vec3 diffuse = vec3(0.0);
    vec3 specular = vec3(0.0);
    if (metallic < 1.0) {
        float fd90_minus_1 = (2.0 * c_l_dot_h * c_l_dot_h * roughness) - 0.5;
        float fd_v = 1.0 + (fd90_minus_1 * schlick_fresnel(c_n_dot_v));
        float fd_l = 1.0 + (fd90_minus_1 * schlick_fresnel(c_n_dot_l));
        diffuse = light_color * ((1.0 / kPi) * fd_v * fd_l * c_n_dot_l * attenuation);
    }
    if (roughness > 0.0) {
        float alpha = roughness * roughness;
        float a = c_n_dot_h * alpha;
        float k = alpha / (1.0 - (c_n_dot_h * c_n_dot_h) + (a * a));
        float d = k * k * (1.0 / kPi);
        float g = 0.5 / mix(2.0 * c_n_dot_l * c_n_dot_v, c_n_dot_l + c_n_dot_v, alpha);
        float f90 = clamp(50.0 * f0.y, 0.0, 1.0);
        vec3 f = f0 + ((f90 - f0) * schlick_fresnel(c_l_dot_h));
        specular = f * (c_n_dot_l * d * g) * light_color * (attenuation * specular_amount);
    }
    return (diffuse * base * (1.0 - metallic)) + specular;
}

// The light the lights send toward v from a surface point, through their shadows: direct_light
// in src/path_trace.cpp.
vec3 direct_light(uint layers, vec3 point, vec3 face, vec3 n, vec3 v, vec3 f0, float roughness,
                  float metallic, vec3 base) {
    vec3 sum = vec3(0.0);
    for (uint k = 0u; k < size.w; ++k) {
        Light light = lights[k];
        if ((light.masks.x & layers) == 0u) {
            continue;
        }
        vec3 toward;
        float distance;
        float attenuation = 1.0;
        if (light.direction.w == 0.0) {
            toward = normalize(light.direction.xyz);
            distance = kFar;
        } else {
            vec3 to_light = light.position.xyz - point;
            distance = length(to_light);
            if (!(distance > 0.0)) {
                continue;
            }
            toward = to_light / distance;
            float nd = distance * light.position.w;
            nd *= nd;
            nd *= nd;
            nd = max(1.0 - nd, 0.0);
            nd *= nd;
            attenuation = nd * power(max(distance, 0.0001), -light.params.x);
            if (light.direction.w == 2.0) {
                float cone = light.params.y;
                float scos = max(dot(-toward, light.direction.xyz), cone);
                float rim = max(0.0001, (1.0 - scos) / (1.0 - cone));
                attenuation *= 1.0 - power(rim, light.params.z);
            }
            if (!(attenuation > 0.0)) {
                continue;
            }
            distance *= 1.0 - 1e-4;
        }
        if (dot(n, toward) <= 0.0) {
            continue;
        }
        float visible = 1.0;
        if (light.masks.z != 0u && light.shadow.x > 0.0 &&
            blocked(offset(point, face, toward), toward, distance, light.masks.y)) {
            visible = 1.0 - light.shadow.x;
        }
        if (visible <= 0.0) {
            continue;
        }
        sum += light_compute(n, toward, v, light.color.rgb, attenuation * visible, f0, roughness,
                             metallic, light.color.w, base);
    }
    return sum;
}

// The light a reflection ray from origin along direction brings back, with 1 in w, or nothing
// where it meets nothing: path_reflection in src/path_trace.cpp.
vec4 reflection(vec3 origin, vec3 direction, uint seed) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsNoneEXT, kSeeMask, origin, 0.0, direction,
                          kFar);
    while (rayQueryProceedEXT(query)) {
        if (keeps(query, direction, seed)) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return vec4(0.0);
    }
    uint index = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
    Draw draw = draws[index];
    Pixel pixel = pixel_at(draw, uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true)),
                           rayQueryGetIntersectionBarycentricsEXT(query, true),
                           rayQueryGetIntersectionObjectToWorldEXT(query, true));
    uint flags = draw.options.x;
    bool front = dot(direction, pixel.face) > 0.0;

    // surface_pixel in src/mesh.cpp.
    vec4 color = albedo_at(draw, pixel);
    vec3 base = srgb_to_linear(color.rgb);
    if ((flags & kUnshaded) != 0u) {
        return vec4(base, 1.0);
    }
    float metallic = draw.surface.x * dot(texel(draw.textures.y, pixel.uv), draw.metallic_channel);
    float roughness =
        draw.surface.y * dot(texel(draw.textures.z, pixel.uv), draw.roughness_channel);
    vec3 normal = pixel.normal;
    if ((flags & kSideCheck) != 0u && !front) {
        normal = -normal;
    }
    if ((flags & kNormalMap) != 0u) {
        vec3 mapped = texel(draw.more.x, pixel.uv).rgb;
        mapped.xy = (mapped.xy * 2.0) - 1.0;
        mapped.z = sqrt(max(0.0, 1.0 - dot(mapped.xy, mapped.xy)));
        vec3 bent = (pixel.tangent * mapped.x) + (pixel.binormal * mapped.y) + (normal * mapped.z);
        normal = normalize(mix(normal, bent, draw.surface.w));
    } else {
        normal = normalize(normal);
    }
    vec3 emitted = draw.emission.rgb;
    if ((flags & kEmissionTexture) != 0u) {
        emitted += texel(draw.textures.w, pixel.uv).rgb;
    }
    emitted = srgb_to_linear(emitted) * draw.emission.w;

    // meet in src/path_trace.cpp: the face and normal toward the ray, then f0.
    vec3 v = -direction;
    vec3 face = normalize(pixel.face);
    if (dot(face, v) < 0.0) {
        face = -face;
    }
    if (dot(normal, v) <= 0.0) {
        normal = face;
    }
    float specular = draw.surface.z;
    float dielectric = 0.16 * specular * specular;
    vec3 f0 = vec3(dielectric) + ((base - vec3(dielectric)) * metallic);
    vec3 direct = direct_light(draw.options.z, pixel.world, face, normal, v, f0, roughness,
                               metallic, base);
    vec3 mirror = normalize((normal * (2.0 * dot(v, normal))) - v);
    vec3 light = emitted + direct + (environment(normal) * base * (1.0 - metallic)) +
                 (environment(mirror) * f0);
    return vec4(light, 1.0);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    vec4 result = vec4(0.0);
    float depth = texelFetch(depth_texture, ivec2(pixel), 0).r;
    vec4 normal_texel = texelFetch(normal_texture, ivec2(pixel), 0);
    float roughness = normal_texel.a * (255.0 / 127.0);
    if (depth > 0.0 && roughness < kReflectionCutoff) {
        // Its place in the world, then its normal turned to face the camera: ray_surface.
        vec2 ndc = vec2(((float(pixel.x) + 0.5) / float(size.x) * 2.0) - 1.0,
                        1.0 - ((float(pixel.y) + 0.5) / float(size.y) * 2.0));
        vec4 clip = to_world * vec4(ndc, depth, 1.0);
        vec3 world = clip.xyz / clip.w;
        vec4 near_clip = to_world * vec4(ndc, 1.0, 1.0);
        vec3 near = near_clip.xyz / near_clip.w;
        vec3 seen = vec3(dot(view_rows[0].xyz, world) + view_rows[0].w,
                         dot(view_rows[1].xyz, world) + view_rows[1].w,
                         dot(view_rows[2].xyz, world) + view_rows[2].w);
        vec3 normal = (normal_texel.rgb * 2.0) - 1.0;
        if (dot(normal, seen) > 0.0) {
            normal = -normal;
        }
        float normal_size = length(normal);
        if (normal_size > 0.0) {
            vec3 out_normal = (view_rows[0].xyz * (normal.x / normal_size)) +
                              (view_rows[1].xyz * (normal.y / normal_size)) +
                              (view_rows[2].xyz * (normal.z / normal_size));
            vec3 origin = world + (out_normal * ((kOffsetShare * length(seen)) + kOffsetLeast));
            vec3 view = normalize(near - origin);
            uint at = (pixel.y * size.x) + pixel.x;
            uint seed = mix_bits(at ^ mix_bits(kReflectionSeed));
            float rough = max(roughness, kMinBounceRoughness);
            vec3 sum = vec3(0.0);
            uint met = 0u;
            for (uint s = 0u; s < size.z; ++s) {
                float u = fract(unit_of(seed) + (float(s) * kR2X));
                float v = fract(unit_of(mix_bits(seed)) + (float(s) * kR2Y));
                vec3 h = sample_visible_normal(out_normal, view, rough * rough, u, v);
                vec3 way = normalize((h * (2.0 * dot(view, h))) - view);
                if (dot(way, out_normal) <= 0.0) {
                    continue; // into the surface: the environment's reflection stays
                }
                vec4 light = reflection(origin, way,
                                        mix_bits(at ^ mix_bits((kReflectionSeed << 16u) ^ s)));
                if (light.w > 0.0) {
                    sum += light.rgb;
                    ++met;
                }
            }
            float share = 1.0 / float(size.z);
            result = vec4(sum * share, float(met) * share);
        }
    }
    imageStore(reflection_image, ivec2(pixel), result);
}
