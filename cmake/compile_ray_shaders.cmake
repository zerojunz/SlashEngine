# Compiles a GLSL compute shader that traces rays (engine/render/shaders/*.comp) into the forms the
# devices that trace rays take, and writes them to a C++ header: SPIR-V for Vulkan (glslang, for
# Vulkan 1.2 with GL_EXT_ray_query), and the GLSL source itself, which CHECK compares. The ray
# shaders are GLSL rather than HLSL as glslang's HLSL has no ray queries. The headers are
# committed, so building the engine needs no shader tools.
#
#   cmake -DSOURCE=<shader.comp> -DOUTPUT=<header> -DNAME=<RayShadows> -DWORKDIR=<dir>
#         -DGLSLANG=<glslangValidator> -P compile_ray_shaders.cmake
#   cmake -DSOURCE=<shader.comp> -DOUTPUT=<header> -DCHECK=ON -P compile_ray_shaders.cmake
#
# With CHECK, nothing is compiled: it fails if the GLSL in OUTPUT differs from SOURCE, which means
# the shader changed and the header wasn't regenerated.

cmake_minimum_required(VERSION 3.25)

file(READ "${SOURCE}" glsl_text)

# MSVC takes string literals of at most 16380 bytes, so the header holds the GLSL as raw string
# literals of kPiece bytes each, which the compiler joins.
set(kPiece 8000)
set(kJoin ")glsl\"\n    R\"glsl(")

if(CHECK)
    file(READ "${OUTPUT}" committed)
    string(REPLACE "${kJoin}" "" committed "${committed}")
    string(FIND "${committed}" "R\"glsl(" start)
    string(FIND "${committed}" ")glsl\"" end REVERSE)
    if(start EQUAL -1 OR end EQUAL -1)
        message(FATAL_ERROR "${OUTPUT} has no GLSL; regenerate it")
    endif()
    math(EXPR start "${start} + 7")
    math(EXPR length "${end} - ${start}")
    string(SUBSTRING "${committed}" ${start} ${length} committed_glsl)
    if(NOT committed_glsl STREQUAL glsl_text)
        message(FATAL_ERROR "${OUTPUT} is out of date with ${SOURCE}; run "
                            "\"cmake --build --preset dev --target shaders\" and commit it")
    endif()
    return()
endif()

if(NOT EXISTS "${GLSLANG}")
    message(FATAL_ERROR "compiling shaders needs glslangValidator: install glslang-tools (apt) or "
                        "glslang (brew)")
endif()

file(MAKE_DIRECTORY "${WORKDIR}")
get_filename_component(base "${SOURCE}" NAME_WE)
set(spirv "${WORKDIR}/${base}.spv")
execute_process(COMMAND "${GLSLANG}" -V --target-env vulkan1.2 "${SOURCE}" -o "${spirv}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "glslang failed for ${SOURCE}:\n${output}")
endif()

# The bytes as a C array body, twelve to a line, 4-byte aligned as Vulkan reads 32-bit words.
file(READ "${spirv}" hex HEX)
string(REGEX REPLACE "(..)" "0x\\1, " hex "${hex}")
string(REPEAT "0x[0-9a-f][0-9a-f], " 11 line)
string(REGEX REPLACE "(${line}0x[0-9a-f][0-9a-f],) " "\\1\n    " hex "${hex}")
string(REGEX REPLACE ",\n    $" ",\n" hex "${hex}")
string(REGEX REPLACE ", $" ",\n" hex "${hex}")

string(LENGTH "${glsl_text}" glsl_length)
set(glsl_pieces "")
set(at 0)
while(at LESS glsl_length)
    string(SUBSTRING "${glsl_text}" ${at} ${kPiece} piece)
    if(at GREATER 0)
        string(APPEND glsl_pieces "${kJoin}")
    endif()
    string(APPEND glsl_pieces "${piece}")
    math(EXPR at "${at} + ${kPiece}")
endwhile()

file(RELATIVE_PATH shown "${CMAKE_CURRENT_LIST_DIR}/.." "${SOURCE}")
set(header "// Generated by cmake/compile_ray_shaders.cmake from ${shown}.
// Don't edit: change the shader, then run \"cmake --build --preset dev --target shaders\".
// clang-format off
#pragma once

namespace slash::render::shaders {

alignas(4) inline constexpr unsigned char k${NAME}Spirv[] = {
    ${hex}};

// The GLSL it was compiled from, which the shaders_up_to_date test compares with the shader.
inline constexpr char k${NAME}Glsl[] = R\"glsl(${glsl_pieces})glsl\";

} // namespace slash::render::shaders
")
file(WRITE "${OUTPUT}" "${header}")
