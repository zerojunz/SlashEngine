Adds the deduction guide Tint's overloaded helper needs on Xcode 15's clang (and clang 16),
which lack C++20's class template argument deduction for aggregates. slash_add_dependency(dawn)
applies it with PATCHES.

--- a/src/tint/lang/core/ir/transform/multiplanar_external_texture.cc
+++ b/src/tint/lang/core/ir/transform/multiplanar_external_texture.cc
@@ -45,6 +45,8 @@
 struct overloaded : Ts... {
     using Ts::operator()...;
 };
+template <class... Ts>
+overloaded(Ts...) -> overloaded<Ts...>;
 
 using MultiplanarTexture = tint::transform::multiplanar::MultiplanarTexture;
 using YCBCRTexture = tint::transform::multiplanar::YCBCRTexture;
