# Writes slash/core/api_hash.hpp: a hash of the engine's public headers and the dependencies it
# pins. Gameplay libraries record it, and the engine refuses to load one built against other
# headers, whose structs might not match its own. Run with
#
#   cmake -DENGINE=<engine folder> -DDEPENDENCIES=<dependencies.json> -DOUTPUT=<header>
#         -P api_hash.cmake
#
# The header is rewritten only when the hash changes, so touching a header rebuilds nothing.
file(GLOB_RECURSE headers RELATIVE ${ENGINE} ${ENGINE}/*/include/*.hpp)
list(SORT headers)
set(listing "")
foreach(header IN LISTS headers)
    file(SHA256 ${ENGINE}/${header} hash)
    string(APPEND listing "${header} ${hash}\n")
endforeach()
file(SHA256 ${DEPENDENCIES} hash)
string(APPEND listing "dependencies.json ${hash}\n")
string(SHA256 api "${listing}")
string(SUBSTRING ${api} 0 16 api)

file(WRITE ${OUTPUT}.tmp
    "// Generated by cmake/api_hash.cmake: a hash of the engine's public headers and pinned\n"
    "// dependencies, which gameplay libraries record (slash/world/game_module.hpp).\n"
    "#pragma once\n"
    "\n"
    "#define SLASH_API_HASH \"${api}\"\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
